{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain pack entities.yaml",
  "$defs": {
    "EntityAlias": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "title": "Lang",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "EntityAlias",
      "type": "object"
    },
    "EntityType": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "attribute_labels": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "minLength": 1
          },
          "title": "Attribute Labels",
          "type": "object"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "title": "EntityType",
      "type": "object"
    },
    "RegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Type",
          "type": "string"
        },
        "key": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityAlias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "type",
        "key",
        "label"
      ],
      "title": "RegistryEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``entities.yaml``.",
  "properties": {
    "types": {
      "items": {
        "$ref": "#/$defs/EntityType"
      },
      "minItems": 1,
      "title": "Types",
      "type": "array"
    },
    "registry": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "title": "Registry",
      "type": "array"
    }
  },
  "required": [
    "types"
  ],
  "type": "object"
}
