{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release manifest.json",
  "$defs": {
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "Outcome of one gate; written to ``manifest.json`` and ``_meta/quality.md``.",
      "properties": {
        "gate": {
          "enum": [
            "G01",
            "G02",
            "G03",
            "G04",
            "G05",
            "G06",
            "G07",
            "G08",
            "G09",
            "G10",
            "G11",
            "G12",
            "G13",
            "G14",
            "G15",
            "G16"
          ],
          "title": "Gate",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "violations": {
          "default": 0,
          "minimum": 0,
          "title": "Violations",
          "type": "integer"
        },
        "details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Details",
          "type": "array"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "name",
        "blocking",
        "status"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "ModelVersion": {
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "minLength": 1,
          "title": "Deployment",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "deployment",
        "model"
      ],
      "title": "ModelVersion",
      "type": "object"
    },
    "ReleaseInputs": {
      "additionalProperties": false,
      "description": "Sources (``source_id`` → ``sha256:…`` of the raw bytes) included in this audience build.",
      "properties": {
        "sources": {
          "default": {},
          "patternProperties": {
            "^src-[0-9a-f]{12}$": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "title": "Sources",
          "type": "object"
        }
      },
      "title": "ReleaseInputs",
      "type": "object"
    },
    "VersionInfo": {
      "additionalProperties": false,
      "description": "Everything that identifies how a release/run was produced (shared by manifest and report).",
      "properties": {
        "docwiki": {
          "minLength": 1,
          "title": "Docwiki",
          "type": "string"
        },
        "wiki_schema": {
          "const": 1,
          "default": 1,
          "title": "Wiki Schema",
          "type": "integer"
        },
        "domain_pack": {
          "minLength": 1,
          "title": "Domain Pack",
          "type": "string"
        },
        "domain_pack_hash": {
          "minLength": 1,
          "title": "Domain Pack Hash",
          "type": "string"
        },
        "prompts": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Prompts",
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelVersion"
          },
          "default": {},
          "title": "Models",
          "type": "object"
        },
        "extractors": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Extractors",
          "type": "object"
        }
      },
      "required": [
        "docwiki",
        "domain_pack",
        "domain_pack_hash"
      ],
      "title": "VersionInfo",
      "type": "object"
    },
    "Violation": {
      "additionalProperties": false,
      "description": "One problem found in a candidate release. ``path`` is relative to the release root.",
      "properties": {
        "gate": {
          "enum": [
            "G01",
            "G02",
            "G03",
            "G04",
            "G05",
            "G06",
            "G07",
            "G08",
            "G09",
            "G10",
            "G11",
            "G12",
            "G13",
            "G14",
            "G15",
            "G16"
          ],
          "title": "Gate",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "code",
        "message"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1,
      "default": 1,
      "title": "Schema",
      "type": "integer"
    },
    "release_id": {
      "pattern": "^(\\d{8}T\\d{6}Z)-([0-9a-f]{8})$",
      "title": "Release Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "audience": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "title": "Audience",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^run-\\d{8}-\\d{6}-[0-9a-f]{8}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "inputs": {
      "$ref": "#/$defs/ReleaseInputs"
    },
    "versions": {
      "$ref": "#/$defs/VersionInfo"
    },
    "counts": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "default": {},
      "title": "Counts",
      "type": "object"
    },
    "gates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "files": {
      "additionalProperties": {
        "$ref": "#/$defs/FileEntry"
      },
      "default": {},
      "title": "Files",
      "type": "object"
    }
  },
  "required": [
    "release_id",
    "created_at",
    "audience",
    "versions"
  ],
  "type": "object"
}
