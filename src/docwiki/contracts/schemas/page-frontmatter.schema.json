          "title": "Lang",
          "type": "string"
        },
        "translation_of": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Of"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "updated": {
          "format": "date",
          "title": "Updated",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9]+(?:[-_/][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "docwiki": {
          "$ref": "#/$defs/DocwikiStamp"
        }
      },
      "required": [
        "title",
        "summary",
        "sensitivity",
        "updated",
        "docwiki"
      ],
      "title": "GlossaryFrontmatter",
      "type": "object"
    },
    "HubFrontmatter": {
      "additionalProperties": false,
      "description": "The hub page of one scope value (v1.7, ADR 0011), built by code: ``hub:<folder>/<key>``\nat ``<folder>/<key>.md`` (``chantiers/moreau.md``).",
