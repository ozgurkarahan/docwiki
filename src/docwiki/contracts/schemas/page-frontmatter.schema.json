            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "docwiki": {
          "$ref": "#/$defs/DocwikiStamp"
        },
        "scope_type": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Scope Type",
          "type": "string"
        },
        "scope": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Scope",
          "type": "string"
