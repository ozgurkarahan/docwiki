{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wiki page frontmatter (discriminated on type)",
  "$defs": {
    "Alias": {
      "additionalProperties": false,
      "description": "Alternative name with a language tag (``{text, lang}``).",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "title": "Lang",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "Alias",
      "type": "object"
    },
    "ContradictionPair": {
      "additionalProperties": false,
      "description": "One open contradiction of a topic page (v1.7): its two sources (sorted ids) and subject.",
      "properties": {
        "sources": {
          "items": {
            "pattern": "^src-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "sources",
        "subject"
      ],
      "title": "ContradictionPair",
      "type": "object"
    },
    "DocwikiStamp": {
      "additionalProperties": false,
      "description": "``docwiki: {schema: 1, release: <release_id>}``.",
      "properties": {
        "schema": {
          "const": 1,
          "default": 1,
          "title": "Schema",
          "type": "integer"
        },
        "release": {
          "pattern": "^(\\d{8}T\\d{6}Z)-([0-9a-f]{8})$",
          "title": "Release",
          "type": "string"
        }
      },
      "required": [
        "release"
      ],
      "title": "DocwikiStamp",
      "type": "object"
    },
    "EntityFrontmatter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "entity",
          "default": "entity",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "lang": {
          "default": "en",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "title": "Lang",
          "type": "string"
        },
        "translation_of": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Of"
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "restricted"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "updated": {
          "format": "date",
          "title": "Updated",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9]+(?:[-_/][a-z0-9]+)*$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "docwiki": {
          "$ref": "#/$defs/DocwikiStamp"
        },
        "entity_type": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Entity Type",
          "type": "string"
        },
        "key": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Alias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "pattern": "^src-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "sensitivity",
        "updated",
        "docwiki",
        "entity_type",
        "key"
      ],
      "title": "EntityFrontmatter",
      "type": "object"
    },
    "ExtractionSummary": {
      "additionalProperties": false,
      "description": "``extraction: {adapter, version, provenance_mix}``; the mix counts blocks per provenance.",
      "properties": {
        "adapter": {
          "enum": [
            "local",
            "content-understanding"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "provenance_mix": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "native-text",
              "ocr",
              "deterministic-table",
              "model-description"
            ]
          },
          "title": "Provenance Mix",
          "type": "object"
        }
      },
      "required": [
        "adapter",
        "version"
      ],
      "title": "ExtractionSummary",
      "type": "object"
    },
    "GlossaryFrontmatter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "glossary",
          "default": "glossary",
