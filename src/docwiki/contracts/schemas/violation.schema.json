{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release validation violation",
  "additionalProperties": false,
  "description": "One problem found in a candidate release. ``path`` is relative to the release root.",
  "properties": {
    "gate": {
      "enum": [
        "G01",
        "G02",
        "G03",
        "G04",
        "G05",
        "G06",
        "G07",
        "G08",
        "G09",
        "G10",
        "G11",
        "G12",
        "G13",
        "G14",
        "G15"
      ],
      "title": "Gate",
      "type": "string"
    },
    "code": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Code",
      "type": "string"
    },
    "severity": {
      "default": "error",
      "enum": [
        "error",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "line": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "gate",
    "code",
    "message"
  ],
  "type": "object"
}
