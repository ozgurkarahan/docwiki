{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run report and cost receipt",
  "$defs": {
    "ContentUnderstandingUsage": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "minLength": 1,
          "title": "Analyzer",
          "type": "string"
        },
        "pages": {
          "default": 0,
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        },
        "price_per_1k_pages": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Per 1K Pages"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        }
      },
      "required": [
        "analyzer"
      ],
      "title": "ContentUnderstandingUsage",
      "type": "object"
    },
    "CostReceipt": {
      "additionalProperties": false,
      "description": "Tokens × price table, Content Understanding pages and duration (USD).",
      "properties": {
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "price_table": {
          "minLength": 1,
          "title": "Price Table",
          "type": "string"
        },
        "llm": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LlmUsage"
          },
          "title": "Llm",
          "type": "array"
        },
        "content_understanding": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContentUnderstandingUsage"
          },
          "title": "Content Understanding",
          "type": "array"
        },
        "duration_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "total_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Cost"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "price_table"
      ],
      "title": "CostReceipt",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "Outcome of one gate; written to ``manifest.json`` and ``_meta/quality.md``.",
      "properties": {
        "gate": {
          "enum": [
            "G01",
            "G02",
            "G03",
            "G04",
            "G05",
            "G06",
            "G07",
            "G08",
            "G09",
            "G10",
            "G11",
            "G12",
            "G13",
            "G14",
            "G15",
            "G16",
            "G17"
          ],
          "title": "Gate",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "violations": {
          "default": 0,
          "minimum": 0,
          "title": "Violations",
          "type": "integer"
        },
        "details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Details",
          "type": "array"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "name",
        "blocking",
        "status"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "LlmUsage": {
      "additionalProperties": false,
      "description": "Token usage of one deployment during a run; prices are USD per 1M tokens.",
      "properties": {
        "role": {
          "enum": [
            "fast",
            "smart"
          ],
          "title": "Role",
          "type": "string"
        },
        "deployment": {
          "minLength": 1,
          "title": "Deployment",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "calls": {
          "default": 0,
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "price_input_per_1m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Input Per 1M"
        },
        "price_cached_input_per_1m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Cached Input Per 1M"
        },
        "price_output_per_1m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Output Per 1M"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        }
      },
      "required": [
        "role",
        "deployment",
        "model"
      ],
      "title": "LlmUsage",
      "type": "object"
    },
    "ModelVersion": {
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "minLength": 1,
          "title": "Deployment",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "deployment",
        "model"
      ],
      "title": "ModelVersion",
      "type": "object"
    },
    "PageChange": {
      "additionalProperties": false,
      "description": "A wiki page the published release added, changed or removed (v1.7), compared with the\nprevious publish; a topic page carries its contradiction count before and after (``None``\nwhen unknown).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "change": {
          "enum": [
            "added",
            "changed",
            "removed"
          ],
          "title": "Change",
          "type": "string"
        },
        "contradictions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contradictions"
        },
        "previous_contradictions": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Contradictions"
        }
      },
      "required": [
        "path",
        "change"
      ],
      "title": "PageChange",
      "type": "object"
    },
    "RunCounts": {
      "additionalProperties": false,
      "properties": {
        "sources_total": {
          "default": 0,
          "minimum": 0,
          "title": "Sources Total",
          "type": "integer"
        },
        "new": {
          "default": 0,
          "minimum": 0,
          "title": "New",
          "type": "integer"
        },
        "changed": {
          "default": 0,
          "minimum": 0,
          "title": "Changed",
          "type": "integer"
        },
        "deleted": {
          "default": 0,
          "minimum": 0,
          "title": "Deleted",
          "type": "integer"
        },
        "unchanged": {
          "default": 0,
          "minimum": 0,
          "title": "Unchanged",
          "type": "integer"
        },
        "quarantined": {
          "default": 0,
          "minimum": 0,
          "title": "Quarantined",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        }
      },
      "title": "RunCounts",
      "type": "object"
    },
    "RunDocument": {
      "additionalProperties": false,
      "description": "A document this run processes (v1.7): new, changed, deleted, or recompiled on request.",
      "properties": {
        "source_id": {
          "pattern": "^src-[0-9a-f]{12}$",
          "title": "Source Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "change": {
          "enum": [
            "new",
            "changed",
            "deleted",
            "recompiled"
          ],
          "title": "Change",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "path",
        "change"
      ],
      "title": "RunDocument",
      "type": "object"
    },
    "StageReport": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "discover",
            "extract",
            "classify",
            "compile",
            "entities",
            "topics",
            "links",
            "indexes",
            "agentkit",
            "evidence",
            "translate",
            "verify",
            "site",
            "publish"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "done",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "duration_s": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "items": {
          "default": 0,
          "minimum": 0,
          "title": "Items",
          "type": "integer"
        },
        "cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "failures": {
          "default": 0,
          "minimum": 0,
          "title": "Failures",
          "type": "integer"
        },
        "errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        }
      },
      "required": [
        "stage",
        "status",
        "started_at"
      ],
      "title": "StageReport",
      "type": "object"
    },
    "VersionInfo": {
      "additionalProperties": false,
      "description": "Everything that identifies how a release/run was produced (shared by manifest and report).",
      "properties": {
        "docwiki": {
          "minLength": 1,
          "title": "Docwiki",
          "type": "string"
        },
        "wiki_schema": {
          "const": 1,
          "default": 1,
          "title": "Wiki Schema",
          "type": "integer"
        },
        "domain_pack": {
          "minLength": 1,
          "title": "Domain Pack",
          "type": "string"
        },
        "domain_pack_hash": {
          "minLength": 1,
          "title": "Domain Pack Hash",
          "type": "string"
        },
        "prompts": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Prompts",
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelVersion"
          },
          "default": {},
          "title": "Models",
          "type": "object"
        },
        "extractors": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Extractors",
          "type": "object"
        }
      },
      "required": [
        "docwiki",
        "domain_pack",
        "domain_pack_hash"
      ],
      "title": "VersionInfo",
      "type": "object"
    },
    "Violation": {
      "additionalProperties": false,
      "description": "One problem found in a candidate release. ``path`` is relative to the release root.",
      "properties": {
        "gate": {
          "enum": [
            "G01",
            "G02",
            "G03",
            "G04",
            "G05",
            "G06",
            "G07",
            "G08",
            "G09",
            "G10",
            "G11",
            "G12",
            "G13",
            "G14",
            "G15",
            "G16",
            "G17"
          ],
          "title": "Gate",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "code",
        "message"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1,
      "default": 1,
      "title": "Schema",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^run-\\d{8}-\\d{6}-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "ingest",
        "recompile",
        "rebuild",
        "reconcile"
      ],
      "title": "Kind",
      "type": "string"
    },
    "requested_by": {
      "enum": [
        "librarian",
        "event",
        "cli",
        "schedule",
        "owner"
      ],
      "title": "Requested By",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "no-op"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "audience": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "title": "Audience",
      "type": "string"
    },
    "release_id": {
      "anyOf": [
        {
          "pattern": "^(\\d{8}T\\d{6}Z)-([0-9a-f]{8})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Id"
    },
    "previous_release_id": {
      "anyOf": [
        {
          "pattern": "^(\\d{8}T\\d{6}Z)-([0-9a-f]{8})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Release Id"
    },
    "messages": {
      "default": 0,
      "minimum": 0,
      "title": "Messages",
      "type": "integer"
    },
    "counts": {
      "$ref": "#/$defs/RunCounts"
    },
    "stages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StageReport"
      },
      "title": "Stages",
      "type": "array"
    },
    "current_stage": {
      "anyOf": [
        {
          "enum": [
            "discover",
            "extract",
            "classify",
            "compile",
            "entities",
            "topics",
            "links",
            "indexes",
            "agentkit",
            "evidence",
            "translate",
            "verify",
            "site",
            "publish"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Stage"
    },
    "documents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RunDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "page_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PageChange"
      },
      "title": "Page Changes",
      "type": "array"
    },
    "gates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "versions": {
      "$ref": "#/$defs/VersionInfo"
    },
    "cost": {
      "$ref": "#/$defs/CostReceipt"
    },
    "errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "kind",
    "requested_by",
    "status",
    "started_at",
    "audience",
    "versions",
    "cost"
  ],
  "type": "object"
}
