{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime overlay work/state/overlay.yaml",
  "$defs": {
    "EntityAlias": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "title": "Lang",
          "type": "string"
        }
      },
      "required": [
        "text",
        "lang"
      ],
      "title": "EntityAlias",
      "type": "object"
    },
    "GlossaryTerm": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "synonyms": {
          "default": {},
          "patternProperties": {
            "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Synonyms",
          "type": "object"
        },
        "see_also": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "See Also",
          "type": "array"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "GlossaryTerm",
      "type": "object"
    },
    "RegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Type",
          "type": "string"
        },
        "key": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityAlias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "type",
        "key",
        "label"
      ],
      "title": "RegistryEntry",
      "type": "object"
    },
    "TopicDef": {
      "additionalProperties": false,
      "properties": {
        "slug": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "keywords": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EntityAlias"
          },
          "title": "Aliases",
          "type": "array"
        },
        "min_score": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Score"
        },
        "min_sources": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Sources"
        }
      },
      "required": [
        "slug",
        "title"
      ],
      "title": "TopicDef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1,
      "default": 1,
      "title": "Schema",
      "type": "integer"
    },
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "title": "Entities",
      "type": "array"
    },
    "glossary": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GlossaryTerm"
      },
      "title": "Glossary",
      "type": "array"
    },
    "topics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TopicDef"
      },
      "title": "Topics",
      "type": "array"
    }
  },
  "type": "object"
}
