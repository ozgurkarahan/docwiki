{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Search hit returned by SearchIndex.search",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "page-section",
        "source-block"
      ],
      "title": "Kind",
      "type": "string"
    },
    "page_id": {
      "title": "Page Id",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "section": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    },
    "anchor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anchor"
    },
    "snippet": {
      "title": "Snippet",
      "type": "string"
    },
    "source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Id"
    },
    "locator_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locator Key"
    },
    "score": {
      "title": "Score",
      "type": "number"
    },
    "lang": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lang"
    }
  },
  "required": [
    "kind",
    "page_id",
    "path",
    "title",
    "snippet",
    "score"
  ],
  "type": "object"
}
