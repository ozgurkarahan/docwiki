{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractedDoc",
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "description": "A unit of extracted content in reading order.",
      "properties": {
        "id": {
          "pattern": "^b\\d{4,}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "heading",
            "paragraph",
            "list",
            "table-ref",
            "figure-ref",
            "slide",
            "email-header",
            "email-body",
            "cue",
            "ocr-line",
            "note"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "csv-rows": "#/$defs/CsvRowsLocator",
              "docx-paragraph": "#/$defs/DocxParagraphLocator",
              "docx-table": "#/$defs/DocxTableLocator",
              "eml-part": "#/$defs/EmlPartLocator",
              "image-region": "#/$defs/ImageRegionLocator",
              "pdf-page": "#/$defs/PdfPageLocator",
              "pptx-slide": "#/$defs/PptxSlideLocator",
              "text-lines": "#/$defs/TextLinesLocator",
              "vtt-cue": "#/$defs/VttCueLocator",
              "xlsx-rows": "#/$defs/XlsxRowsLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfPageLocator"
            },
            {
              "$ref": "#/$defs/DocxParagraphLocator"
            },
            {
              "$ref": "#/$defs/DocxTableLocator"
            },
            {
              "$ref": "#/$defs/XlsxRowsLocator"
            },
            {
              "$ref": "#/$defs/CsvRowsLocator"
            },
            {
              "$ref": "#/$defs/PptxSlideLocator"
            },
            {
              "$ref": "#/$defs/EmlPartLocator"
            },
            {
              "$ref": "#/$defs/VttCueLocator"
            },
            {
              "$ref": "#/$defs/ImageRegionLocator"
            },
            {
              "$ref": "#/$defs/TextLinesLocator"
            }
          ],
          "title": "Locator"
        },
        "provenance": {
          "enum": [
            "native-text",
            "ocr",
            "deterministic-table",
            "model-description"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "lang": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lang"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "locator",
        "provenance"
      ],
      "title": "Block",
      "type": "object"
    },
    "CsvRowsLocator": {
      "additionalProperties": false,
      "description": "CSV rows (1-based, header = row 1).",
      "properties": {
        "kind": {
          "const": "csv-rows",
          "default": "csv-rows",
          "title": "Kind",
          "type": "string"
        },
        "row_start": {
          "minimum": 1,
          "title": "Row Start",
          "type": "integer"
        },
        "row_end": {
          "minimum": 1,
          "title": "Row End",
          "type": "integer"
        }
      },
      "required": [
        "row_start",
        "row_end"
      ],
      "title": "CsvRowsLocator",
      "type": "object"
    },
    "DocMetadata": {
      "additionalProperties": false,
      "properties": {
        "doc_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Number"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "authored": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authored"
        },
        "page_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        }
      },
      "title": "DocMetadata",
      "type": "object"
    },
    "DocxParagraphLocator": {
      "additionalProperties": false,
      "description": "DOCX body paragraph, 1-based index over body paragraphs.",
      "properties": {
        "kind": {
          "const": "docx-paragraph",
          "default": "docx-paragraph",
          "title": "Kind",
          "type": "string"
        },
        "paragraph": {
          "minimum": 1,
          "title": "Paragraph",
          "type": "integer"
        }
      },
      "required": [
        "paragraph"
      ],
      "title": "DocxParagraphLocator",
      "type": "object"
    },
    "DocxTableLocator": {
      "additionalProperties": false,
      "description": "DOCX table (1-based) and row range (1-based, header row = 1).",
      "properties": {
        "kind": {
          "const": "docx-table",
          "default": "docx-table",
          "title": "Kind",
          "type": "string"
        },
        "table": {
          "minimum": 1,
          "title": "Table",
          "type": "integer"
        },
        "row_start": {
          "minimum": 1,
          "title": "Row Start",
          "type": "integer"
        },
        "row_end": {
          "minimum": 1,
          "title": "Row End",
          "type": "integer"
        }
      },
      "required": [
        "table",
        "row_start",
        "row_end"
      ],
      "title": "DocxTableLocator",
      "type": "object"
    },
    "EmlPartLocator": {
      "additionalProperties": false,
      "description": "E-mail part (``headers``, ``body`` or ``attachment:<name>``) and optional line range.",
      "properties": {
        "kind": {
          "const": "eml-part",
          "default": "eml-part",
          "title": "Kind",
          "type": "string"
        },
        "part": {
          "minLength": 1,
          "title": "Part",
          "type": "string"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        }
      },
      "required": [
        "part"
      ],
      "title": "EmlPartLocator",
      "type": "object"
    },
    "ExtractionInfo": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "local",
            "content-understanding"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "analyzer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analyzer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "adapter",
        "adapter_version"
      ],
      "title": "ExtractionInfo",
      "type": "object"
    },
    "Figure": {
      "additionalProperties": false,
      "description": "A figure region; ``description`` (if any) is model-generated and labelled as such.",
      "properties": {
        "id": {
          "pattern": "^f\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "csv-rows": "#/$defs/CsvRowsLocator",
              "docx-paragraph": "#/$defs/DocxParagraphLocator",
              "docx-table": "#/$defs/DocxTableLocator",
              "eml-part": "#/$defs/EmlPartLocator",
              "image-region": "#/$defs/ImageRegionLocator",
              "pdf-page": "#/$defs/PdfPageLocator",
              "pptx-slide": "#/$defs/PptxSlideLocator",
              "text-lines": "#/$defs/TextLinesLocator",
              "vtt-cue": "#/$defs/VttCueLocator",
              "xlsx-rows": "#/$defs/XlsxRowsLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfPageLocator"
            },
            {
              "$ref": "#/$defs/DocxParagraphLocator"
            },
            {
              "$ref": "#/$defs/DocxTableLocator"
            },
            {
              "$ref": "#/$defs/XlsxRowsLocator"
            },
            {
              "$ref": "#/$defs/CsvRowsLocator"
            },
            {
              "$ref": "#/$defs/PptxSlideLocator"
            },
            {
              "$ref": "#/$defs/EmlPartLocator"
            },
            {
              "$ref": "#/$defs/VttCueLocator"
            },
            {
              "$ref": "#/$defs/ImageRegionLocator"
            },
            {
              "$ref": "#/$defs/TextLinesLocator"
            }
          ],
          "title": "Locator"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "description_provenance": {
          "anyOf": [
            {
              "const": "model-description",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description Provenance"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "id",
        "locator",
        "image"
      ],
      "title": "Figure",
      "type": "object"
    },
    "ImageRegionLocator": {
      "additionalProperties": false,
      "description": "Region of a scanned image or photo (``page`` is always 1).",
      "properties": {
        "kind": {
          "const": "image-region",
          "default": "image-region",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "const": 1,
          "default": 1,
          "title": "Page",
          "type": "integer"
        },
        "region": {
          "minimum": 1,
          "title": "Region",
          "type": "integer"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "region",
        "bbox"
      ],
      "title": "ImageRegionLocator",
      "type": "object"
    },
    "PdfPageLocator": {
      "additionalProperties": false,
      "description": "PDF page (text layer or scan). ``bbox`` is normalised, origin top-left.",
      "properties": {
        "kind": {
          "const": "pdf-page",
          "default": "pdf-page",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "page"
      ],
      "title": "PdfPageLocator",
      "type": "object"
    },
    "PptxSlideLocator": {
      "additionalProperties": false,
      "description": "PPTX slide (1-based) and optional shape name/id.",
      "properties": {
        "kind": {
          "const": "pptx-slide",
          "default": "pptx-slide",
          "title": "Kind",
          "type": "string"
        },
        "slide": {
          "minimum": 1,
          "title": "Slide",
          "type": "integer"
        },
        "shape": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        }
      },
      "required": [
        "slide"
      ],
      "title": "PptxSlideLocator",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "description": "A table parsed deterministically (XLSX/CSV) or by layout analysis (PDF/DOCX/PPTX).",
      "properties": {
        "id": {
          "pattern": "^t\\d{2,}$",
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "csv-rows": "#/$defs/CsvRowsLocator",
              "docx-paragraph": "#/$defs/DocxParagraphLocator",
              "docx-table": "#/$defs/DocxTableLocator",
              "eml-part": "#/$defs/EmlPartLocator",
              "image-region": "#/$defs/ImageRegionLocator",
              "pdf-page": "#/$defs/PdfPageLocator",
              "pptx-slide": "#/$defs/PptxSlideLocator",
              "text-lines": "#/$defs/TextLinesLocator",
              "vtt-cue": "#/$defs/VttCueLocator",
              "xlsx-rows": "#/$defs/XlsxRowsLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfPageLocator"
            },
            {
              "$ref": "#/$defs/DocxParagraphLocator"
            },
            {
              "$ref": "#/$defs/DocxTableLocator"
            },
            {
              "$ref": "#/$defs/XlsxRowsLocator"
            },
            {
              "$ref": "#/$defs/CsvRowsLocator"
            },
            {
              "$ref": "#/$defs/PptxSlideLocator"
            },
            {
              "$ref": "#/$defs/EmlPartLocator"
            },
            {
              "$ref": "#/$defs/VttCueLocator"
            },
            {
              "$ref": "#/$defs/ImageRegionLocator"
            },
            {
              "$ref": "#/$defs/TextLinesLocator"
            }
          ],
          "title": "Locator"
        },
        "provenance": {
          "enum": [
            "deterministic-table",
            "native-text",
            "ocr"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/TableRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "artifact": {
          "title": "Artifact",
          "type": "string"
        }
      },
      "required": [
        "id",
        "locator",
        "provenance",
        "columns",
        "rows",
        "artifact"
      ],
      "title": "Table",
      "type": "object"
    },
    "TableRow": {
      "additionalProperties": false,
      "description": "One data row. ``row_id`` encodes the original 1-based row number (``r0012``).",
      "properties": {
        "row_id": {
          "pattern": "^r\\d{4,}$",
          "title": "Row Id",
          "type": "string"
        },
        "cells": {
          "items": {
            "type": "string"
          },
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "row_id",
        "cells"
      ],
      "title": "TableRow",
      "type": "object"
    },
    "TextLinesLocator": {
      "additionalProperties": false,
      "description": "Line range of a Markdown or plain-text file (1-based).",
      "properties": {
        "kind": {
          "const": "text-lines",
          "default": "text-lines",
          "title": "Kind",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        }
      },
      "required": [
        "line_start",
        "line_end"
      ],
      "title": "TextLinesLocator",
      "type": "object"
    },
    "VttCueLocator": {
      "additionalProperties": false,
      "description": "Transcript cue range, ``HH:MM:SS`` (milliseconds truncated by the extractor).",
      "properties": {
        "kind": {
          "const": "vtt-cue",
          "default": "vtt-cue",
          "title": "Kind",
          "type": "string"
        },
        "cue_start": {
          "pattern": "^\\d{2,}:[0-5]\\d:[0-5]\\d$",
          "title": "Cue Start",
          "type": "string"
        },
        "cue_end": {
          "pattern": "^\\d{2,}:[0-5]\\d:[0-5]\\d$",
          "title": "Cue End",
          "type": "string"
        }
      },
      "required": [
        "cue_start",
        "cue_end"
      ],
      "title": "VttCueLocator",
      "type": "object"
    },
    "XlsxRowsLocator": {
      "additionalProperties": false,
      "description": "XLSX sheet rows (1-based, header = row 1).\n\n``sheet_slug`` is the collision-free slug assigned per workbook by the extractor\n(``assign_unique_slugs(sheet_names, max_len=40, fallback=\"sheet\")``); when omitted the slug is\nderived from ``sheet``.",
      "properties": {
        "kind": {
          "const": "xlsx-rows",
          "default": "xlsx-rows",
          "title": "Kind",
          "type": "string"
        },
        "sheet": {
          "minLength": 1,
          "title": "Sheet",
          "type": "string"
        },
        "sheet_slug": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Slug"
        },
        "row_start": {
          "minimum": 1,
          "title": "Row Start",
          "type": "integer"
        },
        "row_end": {
          "minimum": 1,
          "title": "Row End",
          "type": "integer"
        },
        "cols": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Z]{1,3}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cols"
        }
      },
      "required": [
        "sheet",
        "row_start",
        "row_end"
      ],
      "title": "XlsxRowsLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output of the ``extract`` stage, stored as JSON in the extract artifact.",
  "properties": {
    "schema": {
      "const": 1,
      "default": 1,
      "title": "Schema",
      "type": "integer"
    },
    "source_id": {
      "pattern": "^src-[0-9a-f]{12}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    },
    "source_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Hash",
      "type": "string"
    },
    "media_type": {
      "pattern": "^[a-z0-9][a-z0-9.+\\-]*/[a-z0-9][a-z0-9.+\\-]*$",
      "title": "Media Type",
      "type": "string"
    },
    "lang": {
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "title": "Lang",
      "type": "string"
    },
    "title_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title Hint"
    },
    "metadata": {
      "$ref": "#/$defs/DocMetadata"
    },
    "blocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Blocks",
      "type": "array"
    },
    "tables": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Table"
      },
      "title": "Tables",
      "type": "array"
    },
    "figures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Figure"
      },
      "title": "Figures",
      "type": "array"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionInfo"
    }
  },
  "required": [
    "source_id",
    "source_path",
    "source_hash",
    "media_type",
    "lang",
    "extraction"
  ],
  "type": "object"
}
