{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain pack glossary.yaml",
  "$defs": {
    "GlossaryTerm": {
      "additionalProperties": false,
      "properties": {
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "synonyms": {
          "default": {},
          "patternProperties": {
            "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Synonyms",
          "type": "object"
        },
        "see_also": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "See Also",
          "type": "array"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "GlossaryTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``glossary.yaml``.",
  "properties": {
    "terms": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GlossaryTerm"
      },
      "title": "Terms",
      "type": "array"
    }
  },
  "type": "object"
}
