{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE}" },
    "grantDeployerDataAccess": { "value": "${DOCWIKI_GRANT_DEPLOYER_DATA_ACCESS}" },
    "fastModel": { "value": "${DOCWIKI_FAST_MODEL}" },
    "fastModelVersion": { "value": "${DOCWIKI_FAST_MODEL_VERSION}" },
    "fastCapacity": { "value": "${DOCWIKI_FAST_CAPACITY}" },
    "smartModel": { "value": "${DOCWIKI_SMART_MODEL}" },
    "smartModelVersion": { "value": "${DOCWIKI_SMART_MODEL_VERSION}" },
    "smartCapacity": { "value": "${DOCWIKI_SMART_CAPACITY}" },
    "deploymentSku": { "value": "${DOCWIKI_DEPLOYMENT_SKU}" },
    "mcpMinReplicas": { "value": "${DOCWIKI_MCP_MIN_REPLICAS}" },
    "mcpTokenValidation": { "value": "${DOCWIKI_MCP_TOKEN_VALIDATION}" },
    "enablePortal": { "value": "${DOCWIKI_ENABLE_PORTAL}" },
    "portalAccess": { "value": "${DOCWIKI_PORTAL_ACCESS}" },
    "portalMinReplicas": { "value": "${DOCWIKI_PORTAL_MIN_REPLICAS}" },
    "portalCustomDomain": { "value": "${DOCWIKI_PORTAL_CUSTOM_DOMAIN}" },
    "portalCertificateName": { "value": "${DOCWIKI_PORTAL_CERTIFICATE_NAME}" },
    "enableLiveAsk": { "value": "${DOCWIKI_ENABLE_LIVE_ASK}" },
    "liveAskEndpoint": { "value": "${DOCWIKI_LIVE_ASK_ENDPOINT}" },
    "enableEventTrigger": { "value": "${DOCWIKI_ENABLE_EVENT_TRIGGER}" },
    "reconcileCron": { "value": "${DOCWIKI_RECONCILE_CRON}" },
    "audience": { "value": "${DOCWIKI_AUDIENCE}" },
    "domainPack": { "value": "${DOCWIKI_DOMAIN}" },
    "contentUnderstanding": { "value": "${DOCWIKI_CONTENT_UNDERSTANDING}" },
    "enableFoundrySkillsPreview": { "value": "${DOCWIKI_ENABLE_FOUNDRY_SKILLS_PREVIEW}" },
    "enableRoutine": { "value": "${DOCWIKI_ENABLE_ROUTINE}" },
    "enableFoundryTracing": { "value": "${DOCWIKI_ENABLE_FOUNDRY_TRACING}" },
    "networkPerimeter": { "value": "${DOCWIKI_NETWORK_PERIMETER}" },
    "allowedIpRanges": { "value": "${DOCWIKI_ALLOWED_IP_RANGES}" },
    "budgetAmount": { "value": "${DOCWIKI_BUDGET_AMOUNT}" },
    "budgetContactEmails": { "value": "${BUDGET_CONTACT_EMAILS}" },
    "mcpApiClientId": { "value": "${DOCWIKI_MCP_API_CLIENT_ID}" },
    "mcpAllowedClientIds": { "value": "${DOCWIKI_MCP_ALLOWED_CLIENT_IDS}" },
    "mcpConnectionName": { "value": "${DOCWIKI_MCP_CONNECTION}" },
    "portalClientId": { "value": "${DOCWIKI_PORTAL_CLIENT_ID}" },
    "portalOwners": { "value": "${DOCWIKI_PORTAL_OWNERS}" },
    "jobImage": { "value": "${SERVICE_JOB_IMAGE_NAME}" },
    "mcpImage": { "value": "${SERVICE_MCP_IMAGE_NAME}" },
    "portalImage": { "value": "${SERVICE_PORTAL_IMAGE_NAME}" },
    "jobExists": { "value": "${SERVICE_JOB_RESOURCE_EXISTS}" },
    "mcpExists": { "value": "${SERVICE_MCP_RESOURCE_EXISTS}" },
    "portalExists": { "value": "${SERVICE_PORTAL_RESOURCE_EXISTS}" }
  }
}
